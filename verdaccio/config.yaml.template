# Example Verdaccio dual-registry config for Lightwell validated npm.
#
# Pulp often redirects tarball downloads to a CDN. Verdaccio's built-in uplink
# Basic auth can 401 those redirects (Authorization forwarded to the wrong host).
# Recommended topology (what this harness runs):
#
#   npm client → Verdaccio → lightwell-auth-proxy → packages.redhat.com
#                         ↘ npmjs.org
#
# See proxy/lightwell-auth-proxy.js and docs/customer-verdaccio.md.

storage: ./storage

web:
  enable: false
  title: Lightwell npm proxy

auth:
  htpasswd:
    file: ./htpasswd
    max_users: -1

uplinks:
  lightwell:
    # Point at an auth-injecting proxy, not directly at Pulp, when tarball 401s appear.
    url: http://127.0.0.1:4874/
    timeout: 120s
    maxage: 30m
    cache: true
  npmjs:
    url: https://registry.npmjs.org/
    timeout: 60s
    maxage: 30m
    cache: true

packages:
  '@lightwell/*':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: lightwell

  '@*/*':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: lightwell npmjs

  '**':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: lightwell npmjs

middlewares:
  audit:
    enabled: false

logs: { type: stdout, format: pretty, level: http }

listen: 127.0.0.1:4873
